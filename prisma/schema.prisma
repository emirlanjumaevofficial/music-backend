// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider     = "prisma-client"
  output       = "./generated"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id @default(uuid())
  email     String    @unique
  password  String
  firstName String?
  lastName  String?
  avatar    String?   @default("https://ui-avatars.com/api/?name={firstName}+{lastName}&background=random&color=fff&size=128") @map("avatar_url")
  role      Role      @default(USER)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt
  sessions  Session[]
}

enum Role {
  USER
  ADMIN
  SINGER
}

model Session {
  id           String   @id @default(uuid())
  refreshToken String   @unique
  ip           String
  userAgent    String
  deviceInfo   Json?
  location     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}
